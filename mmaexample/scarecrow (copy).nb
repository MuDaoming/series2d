        RowBox[{"-", 
         RowBox[{"JDots", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"Min", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], "}"}], "&"}]}], "]"}]}],
