        RowBox[{"deg", ">", "degexp"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Required deg > degexp, please re-calculate double expansions\>\
\"", "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"intd", "=", 
       RowBox[{"GetIntd", "[", "nu", "]"}]}], ";", "\[IndentingNewLine]", 
