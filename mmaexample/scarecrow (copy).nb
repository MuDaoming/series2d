                RowBox[{"[", "2", "]"}], "]"}], ",", "deg"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"expan", "=", 
             RowBox[{"Series2DAdd", "[", 
              RowBox[{"expan", ",", "temp", ",", "deg"}], "]"}]}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
