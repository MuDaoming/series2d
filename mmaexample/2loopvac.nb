Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GetFinalExp", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GetFinalExp", "[", 
    RowBox[{"nu_", ",", "deg_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"intd", ",", "temp", ",", "expan", ",", "ss"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"deg", ">", "degexp"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Required deg > degexp, please re-calculate double expansions\>\
\"", "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"intd", "=", 
       RowBox[{"GetIntd", "[", "nu", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ss", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"expan", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"deg", "+", "1"}], ",", 
              RowBox[{"deg", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"temp", "=", 
             RowBox[{"Series2DMul", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"dexp", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"intd", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", "deg"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"temp", "=", 
             RowBox[{"Series2DDiv", "[", 
              RowBox[{"temp", ",", 
               RowBox[{
                RowBox[{"intd", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "deg"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"expan", "=", 
             RowBox[{"Series2DAdd", "[", 
              RowBox[{"expan", ",", "temp", ",", "deg"}], "]"}]}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "@", "master"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ss", "[", "i", "]"}], "=", 
          RowBox[{"PolyFormSeries2D", "[", "expan", "]"}]}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "@", "master"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"#", "*", 
            SuperscriptBox["X", "\"\<0\>\""], 
            SuperscriptBox["Y", "\"\<0\>\""]}], "]"}], "/.", " ", 
          RowBox[{
           RowBox[{
            SuperscriptBox["X", 
             RowBox[{"\"\<0\>\"", "+", "n_."}]], 
            SuperscriptBox["Y", 
             RowBox[{"\"\<0\>\"", "+", "m_."}]]}], ":>", "  ", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"n", "+", "1"}]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", "a"}], ")"}], 
               RowBox[{"n", "+", "1"}]], "-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "a"}], ")"}], 
               RowBox[{"n", "+", "1"}]]}], ")"}], 
            FractionBox["1", 
             RowBox[{"m", "+", "1"}]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", "b"}], ")"}], 
               RowBox[{"m", "+", "1"}]], "-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "b"}], ")"}], 
               RowBox[{"m", "+", "1"}]]}], ")"}], 
            SuperscriptBox["s", 
             RowBox[{"n", "+", "m"}]]}]}]}], "&"}], ",", 
        RowBox[{"Values", "[", "ss", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
