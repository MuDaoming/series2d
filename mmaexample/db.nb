      "\[IndentingNewLine]", 
      RowBox[{"b00", "=", 
       RowBox[{"a2", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
