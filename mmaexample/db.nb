          RowBox[{"{", "0", "}"}], "}"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rules", "=", 
       RowBox[{"CoefficientRules", "[", 
        RowBox[{"poly", ",", "vars"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"deg", "=", 
