                RowBox[{"[", "1", "]"}], "]"}], ",", "deg"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"temp", "=", 
             RowBox[{"Series2DDiv", "[", 
              RowBox[{"temp", ",", 
               RowBox[{
                RowBox[{"intd", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "deg"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"expan", "=", 
             RowBox[{"Series2DAdd", "[", 
              RowBox[{"expan", ",", "temp", ",", "deg"}], "]"}]}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "@", "master"}]}], "}"}]}], "]"}], ";", 
