Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"JSector", "[", "vs_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"#", ">", "0"}], ",", "1", ",", "0"}], "]"}], "&"}], "/@", 
    "vs"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JProp", "[", "vs_", "]"}], ":=", 
   RowBox[{"Count", "[", 
    RowBox[{"vs", ",", 
     RowBox[{"_", "?", 
      RowBox[{"(", "Positive", ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JDots", "[", "vs_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"#", ">", "0"}], ",", 
        RowBox[{"#", "-", "1"}], ",", "0"}], "]"}], "&"}], "/@", "vs"}], "//",
     "Total"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sortFIs", "[", "ints_", "]"}], ":=", 
   RowBox[{"SortBy", "[", 
    RowBox[{"ints", ",", 
     RowBox[{
      RowBox[{"{", 
