(* Solve the already generated Blade maximal-cut identities, without rebuilding
   the symbolic topology in another worker. Uses Blade's FiniteFlow solver. *)
base=DirectoryName[DirectoryName[$InputFileName]];out=FileNameJoin[{base,"results","dp_fi_ibp"}];
work=FileNameJoin[{out,"blade_cache","jdpcutcheck_single_dot_cut_1"}];
AppendTo[$Path,"/home/mudaoming/Documents/Packages/blade/blade-main/BLAddOns/BladeIBP"];
AppendTo[$Path,"/usr/local/src/fflow/finiteflow-master/mathlink"];
AppendTo[$LibraryPath,"/usr/local/src/fflow/finiteflow-master"];
Get["BladeIBP.m"];Get["FiniteFlow.m"];
SetSystemOptions[ParallelOptions->ParallelThreadNumber->1];SetSystemOptions[ParallelOptions->MKLThreadNumber->1];
files=FileNames["ids_*.mx",FileNameJoin[{work,"ibps"}]];
If[files==={},Print["BLADE_IBPS_NOT_READY"];Exit[1]];
normalize[x_]:=x/.(h_[f_Symbol,nu_List]/;SymbolName[h]=="BL"&&Length[nu]==11):>BladeIBP`BL[f,nu];
masters=normalize[Get[FileNameJoin[{out,"blade_masters.wl"}]]];
exints=normalize[Get[FileNameJoin[{work,"ibps","exints_def.m"}]]];
eqs=normalize[Join@@(Import/@files)]/.exints;
eqs=eqs/.(BladeIBP`BL[f_,nu_List]/;!And@@Thread[Take[nu,8]>=1]):>0;
eqs=DeleteCases[Expand/@eqs,0];
all=DeleteDuplicates@Cases[eqs,BladeIBP`BL[_,_List],Infinity];
complexity[x_]:=With[{nu=x[[2]]},{-Count[nu,_?Positive],Total[Select[nu,Negative]],-Total[Map[Max[0,#-1]&,nu]],nu}];
all=Join[SortBy[Complement[all,masters],complexity],masters];
indices=1+#&/@Select[Tuples[Range[0,2],8],Total[#]<=2&];target=BladeIBP`BL[jdpcutcheck,Join[#,{0,0,0}]]&/@indices;
Print["BLADE_GENERATED_EQUATIONS=",Length[eqs]," VARIABLES=",Length[all]," TARGETS=",Length[target]];
before=AbsoluteTime[];
FFNewGraph[graph,in,{}];FFAlgSparseSolver[graph,ibps,{in},{},Thread[eqs==0],all,"NeededVars"->target];
FFSolverOnlyHomogeneous[graph,ibps];FFGraphOutput[graph,ibps];learn=FFSparseSolverLearn[graph,all];
If[!ListQ[learn],Print["LEARN_FAILED=",learn];Exit[1]];
{dep,mis}={"DepVars","IndepVars"}/.learn;
If[Sort[mis]=!=Sort[masters],Print["UNEXPECTED_SOLVER_MASTERS=",mis];Exit[1]];
Print["NUMERIC_SOLVER_MASTERS=",Length[mis]," DEPENDENT_OUTPUTS=",Length[dep]];
values=FFReconstructNumeric[graph,"MaxPrimes"->20];
If[!ListQ[values]||Length[values]!=Length[dep]Length[mis]||!FreeQ[values,$Failed],Print["NUMERIC_RECONSTRUCTION_FAILED=",values];Exit[1]];
matrix=Partition[values,Length[mis]];table=Join[Thread[dep->(matrix.mis)],Thread[mis->mis]];
res=target/.table;
If[!FreeQ[res/.Thread[mis->ConstantArray[0,Length[mis]]],_BL]||!And@@(Expand[#/.Thread[mis->ConstantArray[0,Length[mis]]]]===0&/@res),Print["UNREDUCED_TARGETS"];Exit[1]];
Put[Thread[target->res],FileNameJoin[{out,"blade_rules_dot2_from_generated_ibp.wl"}]];
p=1000003;modr[x_]:=Mod[Numerator[Together[x]]PowerMod[Mod[Denominator[Together[x]],p],-1,p],p];
labels=("FI{"<>StringRiffle[ToString/@Take[#[[2]],8],","]<>"}")&/@mis;
records=MapThread[Function[{nu,v},<|"indices"->nu,"coefficients"->AssociationThread[labels,modr/@(Coefficient[Expand[v],#]&/@mis)],"unresolved"->False|>],{indices,res}];
Export[FileNameJoin[{out,"blade_modp_dot2_generated_ibp.json"}],<|"prime"->p,"dimension"->"26/7","master_indices"->(Take[#[[2]],8]&/@mis),"rank_free"->True,"scope"->"Blade generated maximal-cut IBPs; same FiniteFlow sparse solver; no J coefficients used","equations"->Length[eqs],"variables"->Length[all],"numeric_solve_seconds"->(AbsoluteTime[]-before),"records"->records|>,"RawJSON"];
Print["BLADE_GENERATED_IBP_DOT2_DONE seconds=",AbsoluteTime[]-before];
