Export["reductions.json",<|"prime"->prime,"masters"->(mis/.BladeIBP`BL[_,a_List]:>a),"targets"->indices,"values"->values|>,"RawJSON"];Print["NUMERIC_FI_COMPLETE=",metadata];Exit[];
