all=BladeIBP`SortIntegrals[DeleteDuplicates[Join[BladeIBP`IntegralsIn[eqs],needed]]];all=Join[Select[all,!MemberQ[masters,#]&],masters];prime=FiniteFlow`FFPrimeNo[0];
metadata=<|"prime"->prime,"dimension"->fd["dimension"],"targets"->Length[targets],"common_three_branch_targets"->1111,"seed_dot"->2,"seed_rank"->1,"sectors"->Length[sectors],"generated_equations"->generated,"nonzero_equations"->Length[eqs],"variables"->Length[all],"coefficient_nonzeros"->Count[eqs,_BladeIBP`BL,Infinity],"phase"->"generated","generation_seconds"->(AbsoluteTime[]-started)|>;
Export["statistics.json",metadata,"RawJSON"];Print["GENERATED=",metadata];
FiniteFlow`FFNewGraph[graph,in,{}];FiniteFlow`FFAlgSparseSolver[graph,sys,{in},{},Thread[eqs==0],all,"NeededVars"->needed];FiniteFlow`FFSolverOnlyHomogeneous[graph,sys];FiniteFlow`FFGraphOutput[graph,sys];FiniteFlow`FFSetLearningOptions[graph,sys,"PrimeNo"->0];
learn=FiniteFlow`FFSparseSolverLearn[graph,all];{dep,mis}={"DepVars","IndepVars"}/.learn;
If[!ListQ[dep]||!ListQ[mis],Print["LEARN_FAILED=",learn];Exit[2]];
AssociateTo[metadata,<|"dependent_variables"->Length[dep],"master_count"->Length[mis],"extra_masters"->ToString[Complement[mis,masters],InputForm],"phase"->"learned"|>];
independent=FiniteFlow`FFSolverIndepEqs[graph,sys];AssociateTo[metadata,"selected_independent_equations"->Length[independent]];
FiniteFlow`FFSparseSolverMarkAndSweepEqs[graph,sys];FiniteFlow`FFSparseSolverDeleteUnneededEqs[graph,sys];AssociateTo[metadata,"selected_equations_after_pruning"->Length[FiniteFlow`FFSolverIndepEqs[graph,sys]]];Export["statistics.json",metadata,"RawJSON"];
If[Complement[mis,masters]=!={},Print["INSUFFICIENT_SEEDS=",metadata];Exit[3]];
v=FiniteFlow`FFGraphEvaluate[graph,{},"PrimeNo"->0];If[!ListQ[v]||Length[v]!=Length[dep]Length[mis],Print["EVALUATE_FAILED"];Exit[4]];
rows=ArrayReshape[v,{Length[dep],Length[mis]}];rules=Dispatch[Thread[Join[dep,mis]->Join[rows,IdentityMatrix[Length[mis]]]]];values=Replace[expr/.rules,0->ConstantArray[0,Length[mis]],{1}];
If[!MatrixQ[values,IntegerQ]||Dimensions[values]=!={Length[targets],Length[mis]},Print["INVALID_RESULT"];Exit[5]];
