$HistoryLength=0;started=AbsoluteTime[];
out=DirectoryName[$InputFileName];base=DirectoryName[DirectoryName[out]];SetDirectory[out];
fd=Import[FileNameJoin[{base,"input","fi_family.json"}],"RawJSON"];
Get[FileNameJoin[{fd["blade_root"],"Blade.wl"}]];
Unprotect[Blade`Private`CacheDirectory];Clear[Blade`Private`CacheDirectory];
Blade`Private`CacheDirectory[key_]:=FileNameJoin[{out,"cache",ToString[Blade`Private`BLFamily,InputForm]<>"_"<>key}];
BLNthreads=1;BLSSolveNthreads=1;
BLSetReducerOptions["IntegralOrdering"->2];
prop=ToExpression/@fd["propagators"];loops=ToExpression/@fd["loops"];legs=ToExpression/@fd["external_momenta"];sp=(ToExpression[#[[1]]]->ToExpression[#[[2]]])&/@fd["scalar_products"];
fam=e6NativeDot2;
BLFamilyDefine[fam,ToExpression[fd["dimension"]],prop,loops,legs,{},sp,fd["top"],{},ConstantArray[0,Length[prop]]];
If[BLFamilyInf[fam]["Cut"]=!=ConstantArray[0,Length[prop]],Print["ERROR_NONZERO_CUT"];Exit[3]];
masters=BLMaximalCutMasters[fd["top"],{},"PreferredMI"->"Dot"];
Export["masters.json",masters/.BL[_,a_List]:>a,"RawJSON"];
indices=Import[FileNameJoin[{base,"input","all_targets.json"}],"RawJSON"];
targets=BL[fam,Join[#,ConstantArray[0,6]]]&/@indices;
Print["NATIVE_START TARGETS=",Length[targets]," MASTERS=",Length[masters]];
res=BLReduce[Join[targets,masters],masters,"dot2"];
If[!ListQ[res]||Length[res]!=Length[targets]+Length[masters],Print["NATIVE_FAILED=",Short[res]];Exit[2]];
Put[res,"reductions.wl"];
Export["completion.json",<|"targets"->Length[targets],"masters"->Length[masters],"total_seconds"->(AbsoluteTime[]-started),"complete"->True|>,"RawJSON"];
Print["NATIVE_COMPLETE"];Exit[];
